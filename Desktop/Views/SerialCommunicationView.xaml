<UserControl x:Class="Desktop.Views.SerialCommunicationView"
             
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             
             xmlns:local="clr-namespace:Desktop.Views"
             xmlns:vm="clr-namespace:Desktop.ViewModels"
             
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <StackPanel Orientation="Horizontal"
                    Height="60" VerticalAlignment="Top">

            <Border Background="#20262E" 
                CornerRadius="5" 
                Padding="10,5" Height="60"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">
                
                
                <StackPanel Orientation="Horizontal">

                    <!-- Baud Rate selection -->
                    <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False" 
                         VerticalAlignment="Center"
                         Width="80"
                         />
                    <TextBlock Text="Bauds" FontSize="16"
                        VerticalAlignment="Center"
                        Margin="5,0, 20, 0"/>

                    <!-- Serial Port selection-->
                    <ComboBox 
                        ItemsSource="{Binding PortList}" 
                        SelectedIndex="{Binding SelectedPortIndex}"

                        Margin="5"/>

                    <Button Height="32" Width="40"
                        VerticalAlignment="Center"
                        Command="{Binding UpdatePortListCommand}"
            
                        ToolTip="Update the ports list"
                        >

                        <TextBlock FontFamily="Segoe MDL2 Assets" 
                           Text="&#xE72C;" 
                           FontSize="15" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"/>
                    </Button>

                    <!-- DTR selection -->
                    <TextBlock Text="DTR" FontSize="16"
                        VerticalAlignment="Center" Margin="20, 0,0,0"/>
                    <CheckBox IsChecked="{Binding ConnectWithDTR}"
                        Margin="10" Height="30"/>
                </StackPanel>
            </Border>


            <Border Background="#20262E" Margin="30, 0,0,0"
                CornerRadius="5" 
                Padding="10,10" Height="60"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal">

                    <Button Content="Connect" IsEnabled="{Binding CanConnect}"
                            Command="{Binding OpenSerialPortCommand}"/>

                </StackPanel>
                
            </Border>
            
        </StackPanel>
        
    </Grid>
</UserControl>
