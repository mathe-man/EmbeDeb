<Window
    x:Class="Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Desktop"
    Title="Embedeb Desktop">

    <dock:DockingManager x:Name="DockingManager">
        <dock:LayoutRoot>

            <dock:LayoutPanel Orientation="Horizontal">

                <dock:LayoutDocumentPane>

                    <LayoutDocument Title="Time Serie">
                        <views:TimeSerieView/>
                    </LayoutDocument>

                    <LayoutDocument Title="Events">
                        <views:EventView/>
                    </LayoutDocument>
                </dock:LayoutDocumentPane>

                <dock:LayoutDocumentPane>
                    <LayoutDocument Title="Serial Communication">
                        <views:SerialCommunicationView/>
                    </LayoutDocument>
                </dock:LayoutDocumentPane>
                
            </dock:LayoutPanel>
            
        </dock:LayoutRoot>
    </dock:DockingManager>
</Window>
