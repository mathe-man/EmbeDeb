<Window
    x:Class="Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Desktop" 
    
    xmlns:dock="https://github.com/Dirkster99/AvalonDock"
    xmlns:views="clr-namespace:Desktop.Views"
    
    Title="Embedeb Desktop">

    <dock:DockingManager x:Name="DockingManager">
        <dock:LayoutRoot>

            <dock:LayoutPanel Orientation="Horizontal">

                <dock:LayoutDocumentPane>

                    <LayoutDocument Title="Events">
                        <views:EventView/>
                    </LayoutDocument>
                </dock:LayoutDocumentPane>

                <dock:LayoutDocumentPane>
                    <LayoutDocument Title="Serial Communication">
                        <views:SerialCommunicationView/>
                    </LayoutDocument>
                </dock:LayoutDocumentPane>
                
            </dock:LayoutPanel>
            
        </dock:LayoutRoot>
    </dock:DockingManager>
</Window>
